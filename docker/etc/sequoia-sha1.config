# Sequoia crypto-policy: DEFAULT + SHA-1 allowed (additive)
#
# This extends the default policy to accept SHA-1 for signature
# verification, enabling keys with SHA-1 self-signatures (common
# in keys created before ~2020).
#
# Drop this file into /etc/crypto-policies/back-ends/sequoia.config
# and load it in Python with:
#
#   policy = StandardPolicy.from_system_config()
#   verify(bytes=data, store=get_certs, signature=sig, policy=policy)

[hash_algorithms]
md5.collision_resistance = "never"
md5.second_preimage_resistance = "never"
sha1.collision_resistance = "always"
sha1.second_preimage_resistance = "always"
sha224 = "always"
sha256 = "always"
sha384 = "always"
sha512 = "always"
ripemd160 = "never"
default_disposition = "never"

[symmetric_algorithms]
idea = "never"
tripledes = "never"
cast5 = "never"
blowfish = "never"
twofish = "never"
camellia128 = "never"
camellia192 = "never"
camellia256 = "never"
aes128 = "always"
aes192 = "always"
aes256 = "always"
default_disposition = "never"

[asymmetric_algorithms]
rsa1024 = "never"
rsa2048 = "always"
rsa3072 = "always"
rsa4096 = "always"
elgamal1024 = "never"
elgamal2048 = "always"
elgamal3072 = "always"
elgamal4096 = "always"
dsa1024 = "never"
dsa2048 = "never"
dsa3072 = "always"
dsa4096 = "always"
nistp256 = "always"
nistp384 = "always"
nistp521 = "always"
brainpoolp256 = "never"
brainpoolp384 = "never"
brainpoolp512 = "never"
cv25519 = "always"
x25519 = "always"
ed25519 = "always"
x448 = "always"
ed448 = "always"
eddsa = "always"
default_disposition = "never"

[aead_algorithms]
eax = "always"
ocb = "always"
gcm = "always"
default_disposition = "never"
